# Chuẩn hoá xuống dòng: kho lưu LF, checkout ra Windows tự thành CRLF.
* text=auto eol=lf

# File phải giữ CRLF thì Windows mới chạy đúng
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Nhị phân — không đụng vào
*.png  binary
*.jpg  binary
*.pdf  binary
*.nwd  binary
*.nwc  binary
*.nwf  binary
*.ifc  binary
